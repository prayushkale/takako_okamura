---
import { en } from "../lib/i18n";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${en("岡村孝子")} — Slide-by-Slide Discography Deck`,
  description = "One slide per release: cover art, details, and a playable YouTube sample — the complete Takako Okamura solo discography as a presentation.",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@600;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --hue: 348;
    --bg: #141114;
    --ink: #f6f0e8;
    --muted: #b7a99c;
    --line: hsl(var(--hue) 24% 34%);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  html, body { height: 100%; overflow: hidden; }
  body {
    margin: 0;
    background:
      radial-gradient(1300px 660px at 8% -12%, hsl(var(--hue) 82% 34%) 0%, transparent 62%),
      radial-gradient(1050px 600px at 100% 2%, hsl(calc(var(--hue) + 50) 78% 32%) 0%, transparent 58%),
      radial-gradient(1150px 720px at 45% 122%, hsl(calc(var(--hue) - 70) 76% 30%) 0%, transparent 64%),
      var(--bg);
    background-attachment: fixed;
    color: var(--ink);
    font-family: "Noto Sans JP", system-ui, -apple-system, "Hiragino Kaku Gothic ProN", sans-serif;
    line-height: 1.6;
    min-height: 100vh;
  }
  ::selection { background: hsl(var(--hue) 90% 60%); color: #fff; }
  a { color: inherit; }
</style>
