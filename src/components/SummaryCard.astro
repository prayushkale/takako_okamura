---
import type { DeckSummary } from "../lib/slides";
import { en } from "../lib/i18n";

export interface Props {
  summary: DeckSummary;
  index: number;
}

const { summary, index } = Astro.props;
---

<article class="slide summary">
  <div class="slide-top">
    <p class="kicker">
      <span class="pill conclusion">Conclusion</span>
      <span>Slide {index + 1}</span>
      <span aria-hidden="true">·</span>
      <span>{summary.firstYear}–{summary.lastYear}</span>
    </p>
    <h2 class="title">{en("総括")}</h2>
    <p class="sub">All {summary.albumCount} studio albums · complete solo discography</p>
    {summary.bestAlbum && (
      <p class="era">
        Peak: {en(summary.bestAlbum.title)} ({summary.bestAlbum.year}) hit #{
          summary.bestAlbum.oricon
        }
      </p>
    )}
  </div>

  <dl class="stats">
    <div>
      <dt>Albums</dt>
      <dd>{summary.albumCount}</dd>
    </div>
    <div>
      <dt>Singles</dt>
      <dd>{summary.singleCount}</dd>
    </div>
    <div>
      <dt>Tracks</dt>
      <dd>{summary.trackCount}</dd>
    </div>
    <div>
      <dt>Years</dt>
      <dd>{summary.spanYears}</dd>
    </div>
  </dl>

  <ol class="albums">
    {summary.albums.map((a) => (
      <li
        class:list={[
          "album",
          { top: a.oricon != null && a.oricon <= 10, champion: a.oricon === 1 },
        ]}
        style={`--album-hue:${a.hue}`}
      >
        <span class="no">{a.n ?? "—"}</span>
        <span class="body">
          <span class="a-title">{en(a.title)}</span>
          <span class="a-meta">{a.year} · {a.trackCount} tracks</span>
        </span>
        <span class="peak">{a.oricon != null ? `${a.oricon}位` : "—"}</span>
      </li>
    ))}
  </ol>
</article>

<style>
  .slide {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
    height: 100%;
    background: linear-gradient(180deg, hsl(var(--hue) 45% 32% / 0.34), hsl(var(--hue) 40% 14% / 0.12));
    border: 1px solid hsl(var(--hue) 65% 62% / 0.42);
    border-radius: 18px;
    padding: clamp(14px, 2vw, 26px);
    box-shadow: 0 24px 70px -34px hsl(var(--hue) 92% 52% / 0.8);
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pill {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 3px 12px;
    border-radius: 999px;
    border: 1px solid transparent;
  }
  .pill.conclusion {
    background: linear-gradient(120deg, #7c8cff, #34d8b4);
    color: #10201f;
  }
  .title {
    font-family: "Noto Serif JP", serif;
    font-size: clamp(26px, 3.4vw, 46px);
    line-height: 1.12;
    margin: 6px 0 2px;
    letter-spacing: 0.01em;
    background: linear-gradient(100deg, #fff, hsl(var(--hue) 90% 82%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .sub { margin: 0; color: var(--muted); font-size: 14px; }
  .era { margin: 4px 0 0; color: hsl(var(--hue) 90% 74%); font-weight: 700; font-size: 13px; }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
  }
  .stats > div {
    background: linear-gradient(180deg, hsl(var(--hue) 55% 40% / 0.3), rgb(0 0 0 / 0.32));
    border: 1px solid hsl(var(--hue) 70% 66% / 0.4);
    border-radius: 12px;
    padding: 8px 12px;
    min-width: 0;
  }
  .stats dt { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .stats dd {
    margin: 2px 0 0;
    font-family: "Noto Serif JP", serif;
    font-weight: 900;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.1;
    color: hsl(var(--hue) 85% 84%);
  }

  .albums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    grid-auto-rows: 1fr;
    align-content: stretch;
    gap: 8px;
    overflow-y: auto;
    min-height: 0;
    flex: 1 1 auto;
    padding-right: 2px;
  }
  .album {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-left: 4px solid hsl(var(--album-hue) 82% 62%);
    border-radius: 10px;
    font-size: 13px;
    background: linear-gradient(90deg, hsl(var(--album-hue) 60% 40% / 0.18), rgb(0 0 0 / 0.24));
  }
  .album.top {
    border-color: hsl(var(--album-hue) 80% 65% / 0.9);
    box-shadow: inset 0 0 0 1px hsl(var(--album-hue) 85% 60% / 0.35);
  }
  .album.champion {
    background: linear-gradient(90deg, #ffb03a 0%, rgb(0 0 0 / 0.34) 82%);
    border-left-color: #ffcb5c;
  }
  .album.champion .a-title,
  .album.champion .a-meta,
  .album.champion .no { color: #201600; }
  .album .no {
    flex: 0 0 auto;
    min-width: 20px;
    text-align: center;
    font-weight: 800;
    font-size: 12px;
    color: hsl(var(--album-hue) 82% 68%);
  }
  .album .body { flex: 1 1 auto; min-width: 0; display: grid; }
  .album .a-title {
    font-weight: 700;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .album .a-meta { font-size: 11px; color: var(--muted); }
  .album .peak {
    flex: 0 0 auto;
    font-size: 11px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--album-hue) 85% 78%);
    border: 1px solid hsl(var(--album-hue) 60% 62% / 0.5);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .album.champion .peak { color: #201600; border-color: rgb(0 0 0 / 0.4); }

  @media (max-width: 640px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .albums { grid-template-columns: 1fr; }
  }
</style>
