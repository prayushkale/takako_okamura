---
import fs from "node:fs";
import path from "node:path";
import type { Slide } from "../lib/slides";
import { initialsOf } from "../lib/slides";
import { en } from "../lib/i18n";

export interface Props {
  slide: Slide;
}

const { slide } = Astro.props;
const initials = initialsOf(slide.title);

function findCover(id: string): string | null {
  for (const ext of [".jpg", ".jpeg", ".png", ".webp"]) {
    const file = path.join(process.cwd(), "public", "covers", id + ext);
    if (fs.existsSync(file)) return `/covers/${id}${ext}`;
  }
  return null;
}

const coverSrc = findCover(slide.id);
---

<div
  class="cover"
  style={`--hue:${slide.coverHue}`}
  role="img"
  aria-label={`Cover art for ${slide.title}`}
>
  {coverSrc && (
    <>
      <img class="cover-back" src={coverSrc} alt="" aria-hidden="true" loading="lazy" />
      <img class="cover-photo" src={coverSrc} alt={`${slide.title} — jacket art`} loading="lazy" />
    </>
  )}
  <span class="cover-kind">{slide.kind === "single" ? "SINGLE" : "ALBUM"}</span>
  <span class="cover-initials" aria-hidden="true">{initials}</span>
  <span class="cover-title">{en(slide.title)}</span>
  <span class="cover-meta">{slide.year} · {slide.subtitle}</span>
</div>

<style>
  .cover {
    --hue: 348;
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    border-radius: 16px;
    display: grid;
    align-content: space-between;
    padding: 18px;
    color: #fff;
    overflow: hidden;
    background:
      radial-gradient(130% 95% at 18% 0%, hsl(var(--hue) 90% 62% / 0.95) 0%, transparent 58%),
      radial-gradient(120% 120% at 100% 100%, hsl(calc(var(--hue) + 45) 88% 52% / 0.95) 0%, transparent 62%),
      radial-gradient(100% 90% at 0% 100%, hsl(calc(var(--hue) - 55) 86% 55% / 0.78) 0%, transparent 60%),
      linear-gradient(150deg, hsl(var(--hue) 58% 32%) 0%, hsl(calc(var(--hue) + 30) 55% 16%) 100%);
    border: 1px solid hsl(var(--hue) 65% 68% / 0.55);
    box-shadow: 0 24px 70px -24px hsl(var(--hue) 85% 52% / 0.75);
    text-align: left;
  }
  .cover-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(30px) saturate(1.2) brightness(0.7);
    transform: scale(1.15);
  }
  .cover-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cover-kind,
  .cover-initials,
  .cover-title,
  .cover-meta {
    position: relative;
  }
  .cover-photo ~ .cover-kind,
  .cover-photo ~ .cover-initials,
  .cover-photo ~ .cover-title,
  .cover-photo ~ .cover-meta {
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.8);
  }
  .cover-kind {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.22em;
    opacity: 0.85;
  }
  .cover-initials {
    font-family: "Noto Serif JP", serif;
    font-weight: 900;
    font-size: clamp(64px, 11vw, 140px);
    line-height: 1;
    letter-spacing: 0.04em;
    text-shadow: 0 8px 30px rgb(0 0 0 / 0.35);
  }
  .cover-photo ~ .cover-initials {
    display: none;
  }
  .cover-title {
    font-weight: 900;
    font-size: clamp(22px, 3.2vw, 42px);
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cover-meta {
    font-size: 12px;
    letter-spacing: 0.08em;
    opacity: 0.85;
  }
</style>
